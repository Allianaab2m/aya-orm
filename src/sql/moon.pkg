// `SqlOrd` and `SqlNum` are marker traits and `Expr[T]` / `Column[T]` carry a
// phantom `T`: in both cases the type is load-bearing at the signature and
// deliberately absent from the body, which is exactly what these two warnings
// look for. Silenced here so the ones that do mean something stay visible.
warnings = "-unused_type_variable-unused_trait_bound"
