import {
  "Allianaab2m/cairn/sql",
}

// NOTE: no `pre-build` hook here on purpose.
//
// A hook that shells out to `moon run src/gen/cmd` recurses forever, because
// running the generator is itself a build of this same module. Consumers of
// cairn get a prebuilt `cairn-gen` binary and point the hook at that, the way
// morm does with `$mod_dir/.mooncakes/oboard/morm/morm-gen`. Inside this repo
// the example is regenerated explicitly:
//
//   moon run src/gen/cmd -- src/example/entities.mbt -o src/example/entities.g.mbt
