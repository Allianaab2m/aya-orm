import {
  "Allianaab2m/aya",
}

import {
  "Allianaab2m/aya/driver/fake",
  "moonbitlang/async",
} for "test"

// The example's tests exercise the execution layer, and that is `async`, so
// they need `moonbitlang/async` — which supports the native backend only.
//
// Two entities, deliberately: `User` is the plain case where the generated
// table is used directly, and `OrderRow` / `Order` is the seam where a row type
// and a domain sum type are mapped through `table_of`. Everything else worth
// showing is pinned where it is implemented — joins and `Nullable` in
// `src/join_test.mbt`, aggregation in `src/reducer_test.mbt`, nested
// transactions in `src/driver/fake` and `src/driver/sqlite`.

options(
  backend: [ "native" ],
)

// NOTE: no `pre-build` hook here on purpose.
//
// A hook that shells out to `moon run src/kit/cmd` recurses forever, because
// running the generator is itself a build of this same module. Consumers of
// aya get a prebuilt `aya-kit` binary and point the hook at that, the way
// morm does with `$mod_dir/.mooncakes/oboard/morm/morm-gen`. Inside this repo
// the example is regenerated explicitly:
//
//   moon run src/kit/cmd -- codegen
//
// then `moon fmt`, which is what the committed `.g.mbt` files are formatted
// with.
