///|
/// The entity source every test in this file generates from.
let sample : String =
  #|#cairn.table(name="users", alias="u")
  #|pub struct User {
  #|  #cairn.id
  #|  id : Int
  #|  name : String
  #|  age : Int
  #|  #cairn.column(name="deleted_at")
  #|  deleted_at : String?
  #|}
  #|

///|
fn lower(src : String) -> Array[@gen.EntitySpec] raise Error {
  let (impls, reports) = @parser.parse_string(src, name="test.mbt")
  assert_eq(reports.length(), 0)
  @gen.collect_entities(impls)
}

///|
test "attribute parsing keeps namespace and arguments" {
  debug_inspect(
    @gen.parse_attr("#cairn.table(name=\"users\", alias=\"u\")"),
    content=(
      #|Some({ name: "table", args: { "name": "users", "alias": "u" } })
    ),
  )
  debug_inspect(
    @gen.parse_attr("#cairn.id"),
    content=(
      #|Some({ name: "id", args: {} })
    ),
  )
}

///|
test "attributes from other namespaces are ignored" {
  debug_inspect(@gen.parse_attr("#morm.entity"), content="None")
  debug_inspect(@gen.parse_attr("#deprecated"), content="None")
}

///|
test "lowering records declaration order and the primary key" {
  let specs = lower(sample)
  assert_eq(specs.length(), 1)
  let spec = specs[0]
  assert_eq(spec.type_name, "User")
  assert_eq(spec.table, "users")
  assert_eq(spec.tbl, "u")
  debug_inspect(
    spec.fields.map(f => (f.name, f.ty, f.is_primary)),
    content=(
      #|[
      #|  ("id", "Int", true),
      #|  ("name", "String", false),
      #|  ("age", "Int", false),
      #|  ("deleted_at", "String?", false),
      #|]
    ),
  )
}

///|
test "a struct without #cairn.table is skipped" {
  let specs = lower(
    (
      #|pub struct Plain {
      #|  id : Int
      #|}
      #|
    ),
  )
  assert_eq(specs.length(), 0)
}

///|
test "generated source" {
  inspect(
    @gen.emit_file(lower(sample)),
    content=(
      #|// Generated by cairn-kit. DO NOT EDIT.
      #|// Edit the annotated entity struct and re-run the generator instead.
      #|
      #|///|
      #|/// Column handles for `User`.
      #|pub struct UserCols {
      #|  id : @sql.Column[Int]
      #|  name : @sql.Column[String]
      #|  age : @sql.Column[Int]
      #|  deleted_at : @sql.Column[String?]
      #|}
      #|
      #|///|
      #|pub fn User::cols() -> UserCols {
      #|  {
      #|    id: @sql.Column::new(tbl="u", name="id"),
      #|    name: @sql.Column::new(tbl="u", name="name"),
      #|    age: @sql.Column::new(tbl="u", name="age"),
      #|    deleted_at: @sql.Column::new(tbl="u", name="deleted_at"),
      #|  }
      #|}
      #|
      #|///|
      #|/// Select every column of `User`, in declaration order.
      #|pub fn User::all(cols : UserCols) -> @sql.Selection[User] {
      #|  @sql.Selection::new(
      #|    [
      #|      cols.id.raw(),
      #|      cols.name.raw(),
      #|      cols.age.raw(),
      #|      cols.deleted_at.raw(),
      #|    ],
      #|    row => User::{
      #|      id: @sql.SqlDecode::decode(row[0], "id"),
      #|      name: @sql.SqlDecode::decode(row[1], "name"),
      #|      age: @sql.SqlDecode::decode(row[2], "age"),
      #|      deleted_at: @sql.SqlDecode::decode(row[3], "deleted_at"),
      #|    },
      #|  )
      #|}
      #|
      #|///|
      #|/// Write every column of `User`, in declaration order.
      #|pub fn User::binding() -> @sql.Binding[User] {
      #|  @sql.Binding::new(
      #|    ["id", "name", "age", "deleted_at"],
      #|    self => [
      #|      @sql.SqlEncode::to_sql_value(self.id),
      #|      @sql.SqlEncode::to_sql_value(self.name),
      #|      @sql.SqlEncode::to_sql_value(self.age),
      #|      @sql.SqlEncode::to_sql_value(self.deleted_at),
      #|    ],
      #|  )
      #|}
      #|
      #|///|
      #|pub fn User::table() -> @sql.Table[UserCols, User] {
      #|  let cols = User::cols()
      #|  @sql.Table::new(table_name="users", tbl="u", cols~, all=User::all(cols), write=User::binding())
      #|}
      #|
      #|///|
      #|/// Build a table over a domain type mapped to and from `User`.
      #|pub fn[D] User::table_of(
      #|  to_domain : (User) -> D raise @sql.DecodeError,
      #|  from_domain : (D) -> User,
      #|) -> @sql.Table[UserCols, D] {
      #|  let cols = User::cols()
      #|  @sql.Table::new(
      #|    table_name="users",
      #|    tbl="u",
      #|    cols~,
      #|    all=User::all(cols).map(to_domain),
      #|    write=User::binding().contramap(from_domain),
      #|  )
      #|}
      #|
      #|///|
      #|pub fn User::primary_key_name() -> String? {
      #|  Some("id")
      #|}
      #|
    ),
  )
}

///|
test "`type=` is refused because the formatter cannot round-trip it" {
  let src =
    #|#cairn.table(name="accounts", alias="a")
    #|pub struct Account {
    #|  #cairn.column(type="INTEGER")
    #|  id : Int
    #|}
    #|
  try {
    let _ = @gen.entities_of(src, name="test.mbt")
    fail("expected ReservedArg")
  } catch {
    e =>
      inspect(
        e,
        content="`Account`: `type=` cannot be used in an attribute, because `moon fmt` rewrites it into something that will not lex; write `sql_type=` instead",
      )
  }
}

///|
test "an index names fields, and says so when one is missing" {
  let src =
    #|#cairn.table(name="users", alias="u")
    #|#cairn.index(name="idx_users_nope", columns="nope")
    #|pub struct User {
    #|  #cairn.id
    #|  id : Int
    #|}
    #|
  try {
    let _ = @gen.entities_of(src, name="test.mbt")
    fail("expected UnknownIndexColumn")
  } catch {
    e =>
      inspect(
        e,
        content="`User`: #cairn.index names `nope`, which is not a field",
      )
  }
}

///|
test "an index defaults its name to what it indexes" {
  let src =
    #|#cairn.table(name="users", alias="u")
    #|#cairn.index(columns="name, age", unique="true")
    #|pub struct User {
    #|  #cairn.id
    #|  id : Int
    #|  #cairn.column(name="full_name")
    #|  name : String
    #|  age : Int
    #|}
    #|
  debug_inspect(
    @gen.entities_of(src, name="test.mbt")[0].indexes,
    content=(
      #|[
      #|  {
      #|    name: "idx_users_full_name_age",
      #|    columns: ["full_name", "age"],
      #|    unique: true,
      #|  },
      #|]
    ),
  )
}

///|
test "an attribute value may contain a comma" {
  debug_inspect(
    @gen.parse_attr("#cairn.column(default=\"coalesce(a, b)\")"),
    content=(
      #|Some({ name: "column", args: { "default": "coalesce(a, b)" } })
    ),
  )
}
